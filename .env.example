# ============ 全局配置（复制为 .env 填写） ============
# 注意：各应用的 Authentik 凭证与业务参数已迁移至 apps.yaml，此处仅保留网关全局配置。
# .env 已被 .gitignore / .dockerignore 排除。

# Flask 会话密钥：生产环境必须替换为复杂随机字符串（可用 python3 -c "import secrets; print(secrets.token_hex(32))" 生成）
SECRET_KEY=please-change-to-a-random-string

# 网关对外访问地址（含协议、不含末尾斜杠），如 https://sso.example.com；留空则按请求头自动推断
BASE_URL=

# 多应用配置文件路径（默认 apps.yaml，一般无需修改）
# APPS_CONFIG_FILE=apps.yaml

# ---- gunicorn 配置（可选，仅 Docker 部署生效） ----
GUNICORN_WORKERS=2

# ---- 同域路径发布（可选，仅 Docker 部署生效） ----
# WAF 将 https://域名/companysso 透传到本服务时设 /companysso（Flask 自动剥前缀、回调自动带前缀）；
# 子域名/独立域名/本地调试发布则留空
# SCRIPT_NAME=/companysso

# ---- 本地调试配置（可选） ----
# 调试端口（所有环境统一 9010；一般无需修改）
# PORT=9010
